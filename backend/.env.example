# BharatSR Backend Environment Configuration (.env)

# Port to bind (default: 8000; Render supplies PORT=10000)
PORT=8000

# Concurrency thread pool limit for heavy CPU/GPU inference tasks (default: 4)
BHARATSR_MAX_WORKERS=4

# Comma-separated list of allowed CORS origins
# Example for production: https://bharatsr.vercel.app,http://localhost:3000
BHARATSR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://bharatsr.vercel.app

# Optional API key protection for admin/reloading and inference (leave empty for dev/demo)
BHARATSR_API_KEY=

# Default super-resolution neural model (rcan | srcnn | swinir | hat | diffusion | ensemble)
BHARATSR_DEFAULT_MODEL=rcan

# SQLite persistent JobStore database path
BHARATSR_DB_PATH=backend/bharatsr.db

# Transient runs cache directory for GeoTIFF and numpy export
BHARATSR_RUNS_DIR=backend/runs

# Rate limit: Maximum API requests per minute per IP address
BHARATSR_MAX_REQUESTS_PER_MINUTE=60
